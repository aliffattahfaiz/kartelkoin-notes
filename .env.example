# Fine-grained GitHub token, Contents: read+write, scoped to the notes repo only.
GITHUB_REPO=aliffattahfaiz/kartelkoin-notes
GITHUB_TOKEN=

# Shared access key. Generate with: openssl rand -base64 32
# The API refuses every request (503) while this is unset or shorter than 16 chars.
NOTES_WRITE_KEY=
